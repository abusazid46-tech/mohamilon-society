{
  "expo": {
    "name": "Mahamilon Society",
    "slug": "mahamilon-society",
    "version": "1.3.0",
    "orientation": "portrait",
    "icon": "./assets/mahamilon-app-icon.png",
    "userInterfaceStyle": "light",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "org.mahamilonsociety.app",
      "buildNumber": "2"
    },
    "android": {
      "package": "org.mahamilonsociety.app",
      "versionCode": 4,
      "adaptiveIcon": {
        "foregroundImage": "./assets/mahamilon-app-icon.png",
        "backgroundColor": "#ffffff"
      },
      "permissions": [
        "POST_NOTIFICATIONS"
      ]
    },
    "plugins": [
      [
        "expo-notifications",
        {
          "icon": "./assets/mahamilon-app-icon.png",
          "color": "#0b3a82"
        }
      ],
      "expo-secure-store",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/mahamilon-app-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "imageWidth": 220
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "78d453f3-a8b4-45c0-8cff-a44772ac634f"
      }
    },
    "owner": "aruz6"
  }
}
